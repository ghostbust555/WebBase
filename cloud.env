# Settings for cloud deploys: scripts/cloud/*.sh, and the GitHub workflow that
# deploys to Google Cloud. Each deploy applies them, so changing one here and
# pushing is all it takes (docs/GOOGLE_CLOUD.md).
#
# COMMITTED TO GIT, so PUBLIC SETTINGS ONLY. Secrets (keys, passwords,
# connection strings) go in the cloud's secret store, which the setup scripts
# fill, or in .env.local. The scripts refuse to run with one in here.
#
# A value set in the environment or in .env.local wins over this file.
# What each one means: .env.example.

# Where the cloud scripts put things, and how much to pay (docs/GOOGLE_CLOUD.md,
# docs/AZURE.md, docs/AWS.md). Set these before the first setup; leave them
# empty for the defaults. TIER is free (default) or standard (always on, costs more).
GCP_TIER=
GCP_REGION=
# firestore or postgres. Empty = firestore for a new free site, postgres for one already on it or on standard.
# Changing it takes ./scripts/cloud/gcp.sh setup in Cloud Shell, not just a push (docs/GOOGLE_CLOUD.md)
GCP_DATABASE=
AZURE_TIER=
# cosmos or postgres. Empty = cosmos on the free tier (its free account never expires), postgres on standard (docs/AZURE.md)
AZURE_DATABASE=
AZURE_LOCATION=
# ghcr (default: the image GitHub publishes after each push, free) or acr (Azure's own registry, about $5/month)
AZURE_REGISTRY=
AWS_TIER=
AWS_REGION=

# The site's name, in the header and the browser tab.
APP_NAME=
# Google sign-in's client id (public by design). Empty = off. docs/GOOGLE_SIGNIN.md
GOOGLE_CLIENT_ID=

# The CMS (docs/CMS.md). For content in a Google Cloud Storage bucket: set
# CMS_SOURCE=gcs and CMS_GCS_BUCKET, then run ./scripts/cloud/gcp.sh setup once
# to create the bucket and let the app read it (the scripts build the app with
# the storage module; nothing to add to the code).
CMS_ENABLED=false
CMS_SOURCE=files
CMS_GCS_BUCKET=
CMS_GCS_PREFIX=
