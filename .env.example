# ============================================================================
# Settings for this machine. ./setup.sh copies this file to .env.local and
# fills in the secrets for you. .env.local is never committed to git.
#
# After changing .env.local, restart whatever you changed it for:
#   ./dev.sh restart        or        ./deploy.sh restart
# ============================================================================

# The site's name, shown in the browser tab and the header.
APP_NAME=WebBase

# ---- Secrets (setup.sh generates these - don't share them) -----------------

# Signs everyone's sign-in tokens. Anyone who has it can sign in as anyone.
# Changing it signs everybody out.
JWT_KEY=

# Prod database passwords: the owner (changes the tables) and the app (reads
# and writes rows only). Set once, before prod first starts - the database
# remembers them, so changing them here later locks the app out.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=

# ---- Optional features ------------------------------------------------------

# "Sign in with Google". Empty = off. See docs/GOOGLE_SIGNIN.md.
GOOGLE_CLIENT_ID=

# The file-based CMS: pages written as markdown files in content/.
# true = on. See docs/CMS.md.
CMS_ENABLED=false

# Cloudflare Tunnel, to put prod on your own domain. Empty = off.
# See docs/CLOUDFLARE_TUNNEL.md.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Ports on this machine --------------------------------------------------
# Change these if they clash with something else, e.g. a second project made
# from WebBase running on the same computer.

DEV_WEB_PORT=5173
DEV_API_PORT=5000
DEV_DB_PORT=5432
PROD_PORT=8080
