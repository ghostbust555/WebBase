<!-- Settings every C# project in this repository shares. -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- All build output in one folder, .build/, instead of a bin/ and obj/ in
         every project. Docker gives that one folder its own volume. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).build</ArtifactsPath>
  </PropertyGroup>
</Project>
