<!-- Settings every test project shares, on top of the repository's own. -->
<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- "Pass TestContext.Current.CancellationToken everywhere": noise for tests this short. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <!-- The test programs: every project named *.Tests. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- xUnit v3 test projects are small programs of their own. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)WebBase.Testing\WebBase.Testing.csproj" />
    <Using Include="Xunit" />
    <Using Include="WebBase.Testing" />
  </ItemGroup>
</Project>
